#!/bin/bash
#
# dream-init — Copy and customize the Dream KMP template into a new project.
#
# This script copies the canonical temp/ starter project to a destination
# directory, interactively gathers the new app identity, and rewrites all
# template-specific identifiers (package names, app names, bundle IDs, etc.)
# to project-specific values.
#
# Usage:
#   ./dream-init
#
# The script will prompt for:
#   - Destination directory
#   - Project name (e.g. "ExpenseTracker")
#   - App display name (e.g. "Expense Tracker")
#   - Package root (e.g. "com.example.expensetracker")
#

set -euo pipefail

# ──────────────────────────────────────────────
# Color helpers
# ──────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { printf "${CYAN}%s${NC}\n" "$*"; }
ok()    { printf "${GREEN}%s${NC}\n" "$*"; }
warn()  { printf "${YELLOW}%s${NC}\n" "$*"; }
error() { printf "${RED}%s${NC}\n" "$*"; }

# ──────────────────────────────────────────────
# Escape a string for literal use in a sed pattern (BRE).
# ──────────────────────────────────────────────
escape_sed_pattern() {
    printf '%s\n' "$1" | sed 's/[.[\*^$\/&+?(){}|#-]/\\&/g'
}

# ──────────────────────────────────────────────
# Escape a replacement string for sed RHS.
# ──────────────────────────────────────────────
escape_sed_replacement() {
    printf '%s\n' "$1" | sed 's/[\/&]/\\&/g'
}

# ──────────────────────────────────────────────
# Locate the template directory
# ──────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE_DIR="$SCRIPT_DIR/temp"

if [ ! -d "$TEMPLATE_DIR" ]; then
    error "Template directory not found at $TEMPLATE_DIR"
    exit 1
fi

# ──────────────────────────────────────────────
# Interactive prompts
# ──────────────────────────────────────────────
echo ""
info "╔══════════════════════════════════════════════╗"
info "║         Dream Project Initializer            ║"
info "╚══════════════════════════════════════════════╝"
echo ""

while true; do
    read -r -p "$(info "Destination path (absolute): ")" DEST
    DEST="${DEST/#\~/$HOME}"
    if [ -z "$DEST" ]; then
        error "Destination cannot be empty."
        continue
    fi
    if [ -e "$DEST" ]; then
        warn "Already exists: $DEST"
        read -r -p "$(info "Overwrite? (y/N): ")" CONFIRM
        if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
            echo "Aborted."; exit 0
        fi
    fi
    break
done

DEFAULT_PROJECT_NAME="$(basename "$DEST")"
read -r -p "$(info "Project name [${DEFAULT_PROJECT_NAME}]: ")" PROJECT_NAME
PROJECT_NAME="${PROJECT_NAME:-$DEFAULT_PROJECT_NAME}"

if [[ ! "$PROJECT_NAME" =~ ^[a-zA-Z_][a-zA-Z0-9_-]*$ ]]; then
    error "Invalid project name."
    exit 1
fi

DEFAULT_DISPLAY_NAME="$PROJECT_NAME"
read -r -p "$(info "App display name [${DEFAULT_DISPLAY_NAME}]: ")" DISPLAY_NAME
DISPLAY_NAME="${DISPLAY_NAME:-$DEFAULT_DISPLAY_NAME}"

DEFAULT_PACKAGE="com.$(echo "$PROJECT_NAME" | tr '[:upper:]' '[:lower:]' | tr '-' '_')"
read -r -p "$(info "Package root [${DEFAULT_PACKAGE}]: ")" PACKAGE_ROOT
PACKAGE_ROOT="${PACKAGE_ROOT:-$DEFAULT_PACKAGE}"

if [[ ! "$PACKAGE_ROOT" =~ ^[a-z_][a-z0-9_]*(\.[a-z_][a-z0-9_]*)*$ ]]; then
    error "Invalid package root."
    exit 1
fi

read -r -p "$(info "Android app ID [${PACKAGE_ROOT}]: ")" ANDROID_APP_ID
ANDROID_APP_ID="${ANDROID_APP_ID:-$PACKAGE_ROOT}"

echo ""
echo "────────────────────────────────────────────"
info  "Destination:     $DEST"
info  "Project name:    $PROJECT_NAME"
info  "Display name:    $DISPLAY_NAME"
info  "Package root:    $PACKAGE_ROOT"
info  "Android app ID:  $ANDROID_APP_ID"
echo "────────────────────────────────────────────"
read -r -p "$(info "Proceed? (Y/n): ")" CONFIRM
if [ "$CONFIRM" = "n" ] || [ "$CONFIRM" = "N" ]; then
    echo "Aborted."; exit 0
fi

# ──────────────────────────────────────────────
# Derived values
# ──────────────────────────────────────────────
PACKAGE_PATH="${PACKAGE_ROOT//.//}"
ESCAPED_OLD_PKG="$(escape_sed_pattern "com.dream.template")"
ESCAPED_NEW_PKG="$(escape_sed_replacement "$PACKAGE_ROOT")"
ESCAPED_OLD_PROJ="$(escape_sed_pattern "DreamKmpBase")"
ESCAPED_NEW_PROJ="$(escape_sed_replacement "$PROJECT_NAME")"
ESCAPED_OLD_DISP="$(escape_sed_pattern "Dream Template")"
ESCAPED_NEW_DISP="$(escape_sed_replacement "$DISPLAY_NAME")"
ESCAPED_OLD_SAMP="$(escape_sed_pattern "Dream MVP Builder")"
ESCAPED_NEW_SAMP="$(escape_sed_replacement "$DISPLAY_NAME")"

# ──────────────────────────────────────────────
# Step 1: Copy
# ──────────────────────────────────────────────
echo ""
info "📦 Copying template..."

[ -e "$DEST" ] && rm -rf "$DEST"

rsync -a \
    --exclude=".gradle/" --exclude="build/" --exclude=".kotlin/" \
    --exclude=".idea/" --exclude="local.properties" \
    --exclude=".DS_Store" --exclude="*.iml" \
    "$TEMPLATE_DIR/" "$DEST/"

ok "✓ Copied."

# ──────────────────────────────────────────────
# Step 2: Text replacement
# ──────────────────────────────────────────────
info "🔍 Renaming identifiers..."

FILE_TYPES=(-name "*.kt" -o -name "*.kts" -o -name "*.xml" -o -name "*.swift" \
           -o -name "*.xcconfig" -o -name "*.json" -o -name "*.md" \
           -o -name "*.yaml" -o -name "*.yml" -o -name "*.properties" \
           -o -name "*.xcscheme" -o -name "*.pbxproj")

sed_replace() {
    local pattern="$1" replacement="$2"
    while IFS= read -r -d '' f; do
        LC_ALL=C sed -i '' "s/${pattern}/${replacement}/g" "$f" 2>/dev/null || true
    done < <(find "$DEST" -type f \( "${FILE_TYPES[@]}" \) -print0 2>/dev/null)
}

info "  Package root: com.dream.template -> ${PACKAGE_ROOT}"
sed_replace "$ESCAPED_OLD_PKG" "$ESCAPED_NEW_PKG"

info "  Project name: DreamKmpBase -> ${PROJECT_NAME}"
sed_replace "$ESCAPED_OLD_PROJ" "$ESCAPED_NEW_PROJ"

info "  Display name: Dream Template -> ${DISPLAY_NAME}"
sed_replace "$ESCAPED_OLD_DISP" "$ESCAPED_NEW_DISP"

info "  Sample title: Dream MVP Builder -> ${DISPLAY_NAME}"
sed_replace "$ESCAPED_OLD_SAMP" "$ESCAPED_NEW_SAMP"

ok "✓ Identifiers renamed."

# ──────────────────────────────────────────────
# Step 3: Directory restructuring
# ──────────────────────────────────────────────
info "📁 Restructuring directories..."

# Strategy: move children individually to avoid mv existing-dir-to-existing-dir bugs.
# For each "com/dream/template" dir found, create the matching "new_package" dir,
# move all children individually, then remove the empty old dir.
TMP_DIRLIST=$(mktemp)
find "$DEST" -type d -path "*/com/dream/template" 2>/dev/null > "$TMP_DIRLIST" || true

while IFS= read -r old_root; do
    [ -z "$old_root" ] && continue
    new_root="${old_root%com/dream/template}${PACKAGE_PATH}"
    mkdir -p "$new_root"
    for child in "$old_root"/* "$old_root"/.*; do
        b="$(basename "$child")"
        [ "$b" = "." ] && continue
        [ "$b" = ".." ] && continue
        [ -e "$child" ] && mv "$child" "$new_root/" 2>/dev/null || true
    done
    rmdir "$old_root" 2>/dev/null || true
done < "$TMP_DIRLIST"
rm -f "$TMP_DIRLIST"

# Remove empty remnants (bottom-up)
find "$DEST" -depth -type d -name "dream" -empty -delete 2>/dev/null || true
find "$DEST" -depth -type d -name "template" -empty -delete 2>/dev/null || true
find "$DEST" -depth -type d -name "com" -empty -delete 2>/dev/null || true

ok "✓ Directory structure updated."

# ──────────────────────────────────────────────
# Step 4: Reset .mvp/
# ──────────────────────────────────────────────
info "📝 Resetting .mvp/ metadata..."

cat > "$DEST/.mvp/app-contract.yaml" <<- YAMLEOF
name: ${DISPLAY_NAME}
goal: Generated Kotlin Multiplatform MVP application.
templateArchitecture: modular-hybrid
platforms:
  - android
  - ios
  - desktop
backend:
  enabled: false
YAMLEOF

cat > "$DEST/.mvp/decisions.yaml" <<- YAMLEOF
template: dream-kmp-base
architecture: modular-hybrid
ui: compose-multiplatform
desktopPreview: mcp-driven-hot-reload
storage: tbd
YAMLEOF

cat > "$DEST/.mvp/verification-report.md" <<- MDEOF
# Verification Report

## Status

- Overall: partial
- Verification: not-run
- Review: not-run
- Review mode: delegated

## Commands

- none yet

## Notes

- Reset for a new Dream generation cycle.
MDEOF

[ -f "$DEST/.mvp/features/.gitkeep" ] && rm "$DEST/.mvp/features/.gitkeep"

ok "✓ .mvp/ metadata reset."

# ──────────────────────────────────────────────
# Step 5: Cleanup
# ──────────────────────────────────────────────
info "🧹 Cleaning up..."

rm -rf "$DEST/.gradle" "$DEST/build" "$DEST/.kotlin" "$DEST/.idea" \
       "$DEST/local.properties" "$DEST/build-logic/bin" 2>/dev/null || true
find "$DEST" -name ".DS_Store" -delete 2>/dev/null || true
find "$DEST" -name "*.iml" -delete 2>/dev/null || true

ok "✓ Cleanup done."

# ──────────────────────────────────────────────
# Final audit
# ──────────────────────────────────────────────
info "🔎 Running final audit..."

LEFTOVERS=0
check() {
    local label="$1" pat="$2"
    local matches
    matches=$(find "$DEST" -type f \( "${FILE_TYPES[@]}" \) -exec grep -l "$pat" {} + 2>/dev/null | head -5)
    if [ -n "$matches" ]; then
        warn "  ⚠ ${label} still present in:"
        echo "$matches" | sed 's/^/      -> /'
        LEFTOVERS=$((LEFTOVERS + 1))
    fi
}

check "com.dream.template" "com\.dream\.template"
check "DreamKmpBase" "DreamKmpBase"
check "Dream Template" "Dream Template"

if [ "$LEFTOVERS" -eq 0 ]; then
    ok "✓ No template identifiers remained."
else
    warn "⚠ ${LEFTOVERS} pattern(s) still found. Manual review recommended."
fi

# ──────────────────────────────────────────────
# Summary
# ──────────────────────────────────────────────
echo ""
info "╔══════════════════════════════════════════════╗"
info "║           Project initialized!               ║"
info "╚══════════════════════════════════════════════╝"
echo ""
info "  Project:       $PROJECT_NAME"
info "  Location:      $DEST"
info "  Package:       $PACKAGE_ROOT"
info "  Display name:  $DISPLAY_NAME"
info "  Android ID:    $ANDROID_APP_ID"
echo ""
info "Next steps:"
info "  cd $DEST"
info "  ./gradlew allTests"
info "  ./gradlew :desktopApp:compileKotlinJvm"
echo ""
info "To build for Android, set ANDROID_HOME or create local.properties:"
info "  echo 'sdk.dir=/path/to/android/sdk' >> $DEST/local.properties"
info "  ./gradlew :androidApp:assembleDebug"
echo ""
info "Then open in VS Code / OpenCode for Dream's agent workflow."
echo ""
